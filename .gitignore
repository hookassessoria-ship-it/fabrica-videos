node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Fotos do Pixabay: não redistribuir no repo (licença). O credits.json fixa os ids;
# `npm run images:fetch -- <video-id>` baixa de novo as mesmas fotos.
public/images/raw/**/*.jpg
public/images/cut/

public/images/raw/**/*.png

# Narração e testes de voz gerados pela ElevenLabs: não vão pro git
# (`npm run voice:generate -- <id>` gera de novo). A biblioteca de efeitos (public/sfx/)
# vai pro git, pra não precisar gerar de novo.
public/audio/

# Modelos 3D de terceiros (npm run models:fetch baixa de novo); só os créditos vão pro git.
public/models/*.glb

# Clipes de filme usados como comentário (direitos de terceiros): nunca vão pro git.
public/clips/
