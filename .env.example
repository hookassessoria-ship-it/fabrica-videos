# Copie para .env e preencha. O .env nunca vai pro git.

# Fotos (npm run images:fetch). Chave grátis em https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Narração e efeitos sonoros (npm run voice:generate / sfx:generate).
# https://elevenlabs.io → Profile → API keys. No plano grátis só as vozes "premade" funcionam via API.
ELEVENLABS_API_KEY=

# Opcional: Chrome Headless Shell já instalado na máquina. Sem isso, o setup baixa um
# (npx remotion browser ensure).
REMOTION_BROWSER_EXECUTABLE=
