{
  "name": "my-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/captions": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/three": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "@remotion/zod-types": "4.0.537",
    "lucide": "1.59.0",
    "postprocessing": "6.39.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537",
    "three": "0.180.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/three": "0.180.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "setup": "NODE_USE_ENV_PROXY=1 node scripts/setup.mjs",
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "fonts:cache": "NODE_USE_ENV_PROXY=1 node scripts/cache-fonts.mjs",
    "images:fetch": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/images-fetch.mjs",
    "images:cutout": "python3 scripts/cutout.py",
    "textures": "python3 scripts/make-textures.py",
    "render:video": "node --env-file-if-exists=.env scripts/render.mjs",
    "preview:fast": "node --env-file-if-exists=.env scripts/render.mjs --fast",
    "check:numbers": "node --env-file-if-exists=.env scripts/check-numbers.mjs --numbers-only",
    "check:overlap": "node --env-file-if-exists=.env scripts/check-numbers.mjs --overlap-only",
    "check": "node --env-file-if-exists=.env scripts/check-numbers.mjs",
    "voice:generate": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/voice-generate.mjs",
    "sfx:generate": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/sfx-generate.mjs",
    "timeline": "node --env-file-if-exists=.env scripts/timeline.mjs",
    "make:all": "node --env-file-if-exists=.env scripts/make-all.mjs",
    "models:fetch": "NODE_USE_ENV_PROXY=1 node scripts/models-fetch.mjs",
    "clips:credits": "node scripts/clips-credits.mjs",
    "stills": "node --env-file-if-exists=.env scripts/stills.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
